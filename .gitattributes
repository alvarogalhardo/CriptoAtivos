# Normalise text files in the repository to LF.
* text=auto eol=lf

# The Maven wrapper shell script runs on Linux CI runners and inside the Docker
# build. CRLF here makes it fail with "bad interpreter", so force LF.
mvnw          text eol=lf
mvnwDebug     text eol=lf
*.sh          text eol=lf

# Windows batch files must keep CRLF.
mvnw.cmd      text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binary assets — never touch these.
*.jar         binary
*.jpg         binary
*.png         binary
*.pdf         binary
*.zip         binary
