# Copy to .env and edit. Compose reads .env automatically.
#
# Every value below has a development default that works out of the box.
# All three MUST be changed before exposing this instance to anyone.

# Signs and encrypts TOTP secrets at rest.
ENCRYPTION_PASSWORD=dev-only-change-me

# Password for the administrator seeded on first start.
# Set ADMIN_SEED_ENABLED=false to skip seeding entirely.
ADMIN_PASSWORD=change-me-immediately

# coingecko = live market data, manual = admin-set prices only (no network).
PRICE_PROVIDER=coingecko
